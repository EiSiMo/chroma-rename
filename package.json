{
  "name": "claude-session-titler",
  "version": "0.1.0",
  "private": true,
  "description": "Names Claude Code sessions after their main piece of work, and keeps the name current as the work moves.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc -p .",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:plugin": "claude plugin test .",
    "validate": "claude plugin validate .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run validate && npm run test:plugin",
    "version": "node version-bump.mjs && git add .claude-plugin/plugin.json"
  },
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^17.12.0",
    "jiti": "^2.7.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
